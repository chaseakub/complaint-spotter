{
  "manifest_version": 3,
  "name": "Replio Complaint Spotter",
  "short_name": "Complaint Spotter",
  "version": "1.0.0",
  "description": "Count which complaints repeat in the restaurant reviews on your screen, at every star rating. Runs in your browser. Nothing is uploaded.",
  "homepage_url": "https://www.repliohq.com/reports/restaurant-review-complaints-2026",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Count complaints in these reviews",
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
